{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop Manager",
  "version": "0.5.1",
  "identifier": "it.jmagarelli.dsh-desktop-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/necos98/dsh-desktop-manager/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQUI1NTA3NDM4Mjk1NEQKUldSTmxZSkRCMVdyMitvdFUwWVkrSHhNV1N0QzdkUnZIbkRydmdIVThNTC9hU2tpWE1zOEEzZWYK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png"
    ]
  }
}
