{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop Manager",
  "version": "0.1.0",
  "identifier": "it.jmagarelli.dsh-desktop-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
